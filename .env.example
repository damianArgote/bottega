# Copy to .env and fill in the values. Secrets have no defaults: the app
# refuses to start while a required one is empty. See README "Configurar el .env".

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local Docker: postgresql://bottega:bottega@localhost:5432/bottega
# Neon: the pooled URL (host with "-pooler").
DATABASE_URL=postgresql://bottega:bottega@localhost:5432/bottega
# Neon only: the direct URL, used only by `prisma migrate`. Leave it unset for
# local Docker (DATABASE_URL is used instead).
# On Neon, append to both URLs: ?sslmode=require&connect_timeout=15
# (the compute suspends when idle; without the timeout Prisma fails with P1001).
DATABASE_URL_UNPOOLED=

# --- WhatsApp / Meta: the default line (optional) ---
# Serve the keyless /webhooks/whatsapp route and feed `npm run
# seed:default-line`. Without them the app starts and that route answers 404.
# Every line keeps its own encrypted credentials in the database.
# App settings -> Basic -> App secret. Validates every webhook signature.
META_APP_SECRET=
# A value you choose (e.g. `openssl rand -hex 16`); paste the same in Meta.
WHATSAPP_VERIFY_TOKEN=
# System User token (the API Setup one expires in hours).
WHATSAPP_ACCESS_TOKEN=
# The phone number ID from API Setup, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_HTTP_TIMEOUT_MS=10000

# --- Bot and AI ---
# echo | ai. OPENAI_API_KEY and OPENAI_MODEL are required when ai.
BOT_REPLY_MODE=echo
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=300
AI_MAX_INTERACTIONS_PER_USER_PER_DAY=30
AI_MAX_INTERACTIONS_PER_BUSINESS_PER_MONTH=5000
AI_HISTORY_LIMIT=12
CATALOG_MAX_ITEMS_PER_BUSINESS=2000

# --- Job queue ---
JOB_MAX_ATTEMPTS=4
WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=1000
# Wait between polls when the queue is idle (10 min), so Neon can suspend.
QUEUE_IDLE_POLL_INTERVAL_MS=600000
QUEUE_CONCURRENCY=2
QUEUE_LEASE_MS=120000

# --- Public URL (optional) ---
# Builds each line's webhook URL in the admin API. On Render it is not needed:
# RENDER_EXTERNAL_URL (set by Render) is used instead.
PUBLIC_BASE_URL=

# --- Credential encryption (required) ---
# Encrypts per-line Meta credentials at rest (AES-256-GCM): 32 random bytes in
# base64, `openssl rand -base64 32`. Losing or changing it makes the stored
# credentials unreadable. Use a different value per environment.
TOKEN_ENCRYPTION_KEY=

# --- Admin API (required) ---
# At least 32 characters: `openssl rand -hex 32`.
ADMIN_API_KEY=

# --- Inbox sessions (required) ---
# Signs the session JWTs. At least 32 characters: `openssl rand -base64 48`.
# Use a different value per environment; changing it ends every session.
JWT_SECRET=
# Origin of the inbox web app, the only one CORS allows (with credentials):
# scheme, host and optional port, no path. Locally: http://localhost:4200
INBOX_ORIGIN=

# --- Web Push to the inbox (optional: the three or none) ---
# With none, push is off. With only some, the app does not start.
# Generate the pair once per environment: `npx web-push generate-vapid-keys`.
# Changing it invalidates every saved browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:someone@example.com or an https URL.
VAPID_SUBJECT=
