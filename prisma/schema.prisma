// Prisma 7 schema for bottega-api.
// The datasource URL lives in prisma.config.ts (not here) as required by Prisma 7.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ConversationMode {
  COMMERCIAL
  DEMO

  @@map("conversation_mode")
}

enum ContextEndReason {
  RESET
  MODE_SWITCH

  @@map("context_end_reason")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageType {
  TEXT
  UNSUPPORTED
  SYSTEM

  @@map("message_type")
}

/// Inbound statuses: RECEIVED, PROCESSED, IGNORED.
/// Outbound statuses: QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, UNCERTAIN.
enum MessageStatus {
  RECEIVED
  PROCESSED
  IGNORED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNCERTAIN

  @@map("message_status")
}

enum MessageAuthor {
  BOT
  HUMAN
  USER

  @@map("message_author")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCARDED

  @@map("lead_status")
}

enum HandoffStatus {
  OPEN
  RESOLVED

  @@map("handoff_status")
}

enum JobType {
  INBOUND_MESSAGE
  /// Web Push to the inbox people; runs outside the conversation's order.
  PUSH_NOTIFICATION

  @@map("job_type")
}

/// Why a PUSH_NOTIFICATION job notifies.
enum PushReason {
  INBOUND
  HANDOFF

  @@map("push_reason")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  /// Done without a reply: a person attends the conversation (assigned) or
  /// the bot is paused.
  SKIPPED

  @@map("job_status")
}

enum AiOutcome {
  OK
  ERROR
  LIMITED

  @@map("ai_outcome")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A business served by Bottega (one Meta app and portfolio per business).
model Business {
  id                           String    @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String    @unique
  /// How the bot introduces itself, e.g. "BotSuite, IA de BotSuite46".
  /// Initial value of AgentProfile.botName; the profile's name is the one used.
  botName                      String    @map("bot_name")
  /// IANA zone for the business's opening hours.
  timezone                     String    @default("America/Argentina/Buenos_Aires")
  /// AI replies per calendar month (America/Argentina/Buenos_Aires) for the
  /// whole business; null uses AI_MAX_INTERACTIONS_PER_BUSINESS_PER_MONTH.
  aiMonthlyCap                 Int?      @map("ai_monthly_cap")
  /// AI replies per conversation per day; null uses
  /// AI_MAX_INTERACTIONS_PER_USER_PER_DAY.
  aiDailyCapPerConversation    Int?      @map("ai_daily_cap_per_conversation")
  /// Catalog items the business may have; null uses
  /// CATALOG_MAX_ITEMS_PER_BUSINESS.
  catalogItemCap               Int?      @map("catalog_item_cap")
  /// The confirmed column mapping and the headers it was made for:
  /// { headers, mapping }. Reused while the headers do not change.
  catalogMapping               Json?     @map("catalog_mapping")
  /// Google Sheet published as CSV, re-read every hour.
  catalogSheetUrl              String?   @map("catalog_sheet_url")
  /// When the sheet is due again (claimed by the worker, then moved ahead).
  catalogSyncNextAt            DateTime? @map("catalog_sync_next_at")
  /// Last sheet sync attempt and its error code (null when it worked).
  catalogSyncedAt              DateTime? @map("catalog_synced_at")
  catalogSyncError             String?   @map("catalog_sync_error")
  /// Longest audio the bot transcribes, in seconds; null uses
  /// MEDIA_AUDIO_MAX_SECONDS.
  audioMaxSeconds              Int?      @map("audio_max_seconds")
  /// Attachments processed per conversation per day; null uses
  /// MEDIA_MAX_PER_CONVERSATION_PER_DAY.
  mediaDailyCapPerConversation Int?      @map("media_daily_cap_per_conversation")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  lines                Line[]
  contacts             Contact[]
  agentProfile         AgentProfile?
  agentProfileVersions AgentProfileVersion[]
  leads                Lead[]
  memberships          Membership[]
  catalogItems         CatalogItem[]
  catalogImports       CatalogImport[]
  catalogAiUsage       CatalogAiUsage[]

  @@map("business")
}

/// The AI agent of a business (one per business in the MVP). Validated by
/// agentProfileSchema (src/agents) on every write; every text field is
/// business information for the prompt, never system instructions.
model AgentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @unique @map("business_id") @db.Uuid
  enabled           Boolean  @default(true)
  botName           String   @map("bot_name")
  persona           String   @default("")
  /// Markdown: services, prices, hours, area, payment methods.
  businessInfo      String   @default("") @map("business_info")
  /// [{ question, answer }]
  faq               Json     @default("[]")
  /// [{ key, label, required, kind }]
  leadFields        Json     @default("[]") @map("lead_fields")
  handoffRules      String   @default("") @map("handoff_rules")
  outOfHoursMessage String?  @map("out_of_hours_message")
  /// { mon: ["09:00-18:00"], ... } in Business.timezone; null: no notice.
  openingHours      Json?    @map("opening_hours")
  /// OpenAI model id; null uses OPENAI_MODEL.
  model             String?
  demoEnabled       Boolean  @default(false) @map("demo_enabled")
  /// Goes up on every change; recorded on AiUsage.
  version           Int      @default(1)
  /// Who made the last change; null: the admin API, the seed or unknown.
  updatedById       String?  @map("updated_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  updatedBy User?    @relation("AgentProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("agent_profile")
}

/// The agent profile as it was saved at each version, to compare and restore.
model AgentProfileVersion {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  /// AgentProfile.version this snapshot was saved as.
  version     Int
  /// The profile's fields (agentProfileSchema), as saved.
  snapshot    Json
  /// null: the admin API, the seed or unknown.
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("AgentProfileVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, version])
  @@map("agent_profile_version")
}

/// A WhatsApp phone number of a business, with its own Meta credentials.
/// Secrets are stored encrypted (LineCredentialsService) and never returned.
model Line {
  id                   String    @id @default(uuid()) @db.Uuid
  businessId           String    @map("business_id") @db.Uuid
  /// Meta phone number id (not the phone number). Routes inbound events.
  /// Null while the line is a draft being onboarded (no number yet).
  phoneNumberId        String?   @unique @map("phone_number_id")
  /// Messaging account id. Null for the default line seeded from the env.
  wabaId               String?   @map("waba_id")
  displayPhone         String?   @map("display_phone")
  appId                String?   @map("app_id")
  appSecretEncrypted   String?   @map("app_secret_encrypted")
  /// System User token of the business, encrypted.
  accessTokenEncrypted String?   @map("access_token_encrypted")
  /// Generated by Bottega; pasted in the Meta app's webhook configuration.
  verifyToken          String    @map("verify_token")
  /// Random URL-safe key in /webhooks/whatsapp/:webhookKey.
  webhookKey           String    @unique @map("webhook_key")
  /// When the team confirmed the Meta app is in Live mode (some webhooks
  /// are not sent in Development mode). Null: not confirmed yet.
  appPublishedAt       DateTime? @map("app_published_at")
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  webhookEvents WebhookEvent[]

  @@index([businessId])
  @@map("line")
}

/// A WhatsApp user as seen by one business (the same person is a different
/// contact for each business).
model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  waId        String   @map("wa_id")
  /// Name sent by Meta in the webhook profile.
  profileName String?  @map("profile_name")
  /// Name set by an operator.
  name        String?
  optOut      Boolean  @default(false) @map("opt_out")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@unique([businessId, waId])
  @@map("contact")
}

/// One thread per (line, contact): it is reopened, never split.
model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  lineId             String             @map("line_id") @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  mode               ConversationMode   @default(COMMERCIAL)
  paused             Boolean            @default(false)
  pausedAt           DateTime?          @map("paused_at")
  /// Day (Business.timezone) the out-of-hours notice was last added.
  outOfHoursNoticeOn DateTime?          @map("out_of_hours_notice_on") @db.Date
  activeContextId    String?            @unique @map("active_context_id") @db.Uuid
  /// Last inbound message time (sent time). The window rule uses windowExpiresAt.
  lastInboundAt      DateTime?          @map("last_inbound_at")
  /// Inbox state (src/inbox/conversation-state.ts).
  status             ConversationStatus @default(OPEN)
  /// The person attending it; while set, the bot does not answer.
  assignedToId       String?            @map("assigned_to_id") @db.Uuid
  unreadCount        Int                @default(0) @map("unread_count")
  lastMessageAt      DateTime?          @map("last_message_at")
  lastMessagePreview String?            @map("last_message_preview") @db.VarChar(120)
  /// End of WhatsApp's 24 h customer service window; never moves back.
  windowExpiresAt    DateTime?          @map("window_expires_at")
  /// Set by the conversation_track_change trigger on every insert and update
  /// (pg_current_xact_id()); the /changes cursor. Never written by the app.
  changeTxid         BigInt             @default(0) @map("change_txid")
  /// Raised by the same trigger on every update.
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  line            Line                  @relation(fields: [lineId], references: [id], onDelete: Restrict)
  contact         Contact               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  activeContext   ConversationContext?  @relation("ActiveContext", fields: [activeContextId], references: [id], onDelete: SetNull)
  assignedTo      User?                 @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contexts        ConversationContext[] @relation("ConversationContexts")
  messages        Message[]
  lead            Lead?
  demoRequests    DemoRequest[]
  handoffRequests HandoffRequest[]
  processingJobs  ProcessingJob[]
  aiUsages        AiUsage[]

  @@unique([lineId, contactId])
  @@index([contactId])
  @@index([lineId, status, lastMessageAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([lineId, changeTxid])
  @@map("conversation")
}

model ConversationContext {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  mode           ConversationMode
  /// Fictitious business of a DEMO context ("insurance", "barbershop"); null in COMMERCIAL (and in DEMO contexts older than the scenarios: barbershop).
  demoScenario   String?           @map("demo_scenario")
  startedAt      DateTime          @default(now()) @map("started_at")
  endedAt        DateTime?         @map("ended_at")
  endReason      ContextEndReason? @map("end_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  conversation Conversation  @relation("ConversationContexts", fields: [conversationId], references: [id], onDelete: Cascade)
  activeFor    Conversation? @relation("ActiveContext")
  messages     Message[]
  demoRequests DemoRequest[]

  @@index([conversationId, startedAt])
  @@map("conversation_context")
}

model Message {
  /// Insertion order (autoincrement); the inbox pages messages by it.
  seq            BigInt           @unique @default(autoincrement())
  /// Reply buttons sent under the text ([{ id, title }], at most 3).
  buttons        Json?
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  contextId      String?          @map("context_id") @db.Uuid
  /// WhatsApp message id (wamid). Unique to deduplicate webhook retries.
  waMessageId    String?          @unique @map("wa_message_id")
  direction      MessageDirection
  type           MessageType
  content        String
  status         MessageStatus
  /// Idempotency key for outbound messages generated by a job.
  idempotencyKey String?          @unique @map("idempotency_key")
  author         MessageAuthor
  errorCode      String?          @map("error_code")
  /// Attachment (inbound): image, audio, document, video, sticker,
  /// location or other. Media is stored with type UNSUPPORTED (location as
  /// TEXT) so the previous release reads it; null for plain text.
  mediaKind      String?          @map("media_kind")
  /// Meta media id; the file stays in Meta (deleted there after 30 days).
  mediaId        String?          @map("media_id")
  mediaMime      String?          @map("media_mime")
  mediaSize      Int?             @map("media_size")
  mediaFilename  String?          @map("media_filename")
  /// Audio recorded as a voice note.
  mediaVoice     Boolean?         @map("media_voice")
  /// Automatic transcription of an audio (kept after Meta deletes it).
  transcript     String?
  /// Why the attachment was not processed: too_long, too_large, daily_cap,
  /// ai_cap, unsupported_type, transcription_failed, empty_transcript,
  /// media_gone.
  mediaError     String?          @map("media_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  conversation  Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  context       ConversationContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  processingJob ProcessingJob?       @relation("JobMessage")
  pushJobs      ProcessingJob[]      @relation("PushMessage")

  @@index([contextId, createdAt])
  @@index([conversationId, createdAt])
  @@map("message")
}

/// Real prospect data captured in commercial mode.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @unique @map("conversation_id") @db.Uuid
  businessId     String     @map("business_id") @db.Uuid
  /// Captured values by lead field key (AgentProfile.leadFields).
  data           Json       @default("{}")
  status         LeadStatus @default(NEW)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("lead")
}

/// Fictitious booking captured while running a demo scenario.
model DemoRequest {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  contextId      String   @map("context_id") @db.Uuid
  /// Demo scenario identifier, e.g. "barbershop".
  scenario       String
  customerName   String?  @map("customer_name")
  service        String?
  preferredDate  String?  @map("preferred_date")
  preferredTime  String?  @map("preferred_time")
  notes          String?
  /// Scenario-specific data (e.g. the insurance quote: vehicle, zone, plan, price).
  details        Json?
  isFictitious   Boolean  @default(true) @map("is_fictitious")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  context      ConversationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("demo_request")
}

model HandoffRequest {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  reason         String?
  status         HandoffStatus @default(OPEN)
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("handoff_request")
}

/// PostgreSQL-backed job queue. A partial unique index (added by hand in the
/// initial migration) guarantees at most one PROCESSING job per conversation.
model ProcessingJob {
  id             String      @id @default(uuid()) @db.Uuid
  /// Monotonic enqueue order. Used by the queue to process the jobs of one
  /// conversation strictly in arrival order (created_at has ms resolution).
  seq            BigInt      @unique @default(autoincrement())
  type           JobType
  conversationId String      @map("conversation_id") @db.Uuid
  /// The inbound message the bot answers; null for PUSH_NOTIFICATION jobs
  /// (the previous release's worker then fails them instead of taking one
  /// for a message to answer).
  messageId      String?     @unique @map("message_id") @db.Uuid
  /// Set only for PUSH_NOTIFICATION jobs.
  pushReason     PushReason? @map("push_reason")
  /// The message a push shows; null for a handoff.
  pushMessageId  String?     @map("push_message_id") @db.Uuid
  status         JobStatus   @default(PENDING)
  attempts       Int         @default(0)
  maxAttempts    Int         @map("max_attempts")
  runAfter       DateTime    @default(now()) @map("run_after")
  leaseExpiresAt DateTime?   @map("lease_expires_at")
  lockedBy       String?     @map("locked_by")
  lastError      String?     @map("last_error")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation("JobMessage", fields: [messageId], references: [id], onDelete: Cascade)
  pushMessage  Message?     @relation("PushMessage", fields: [pushMessageId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([conversationId, createdAt])
  @@map("processing_job")
}

/// AI call accounting for the daily per-user cap. Never stores message content.
model AiUsage {
  id                  String    @id @default(uuid()) @db.Uuid
  conversationId      String    @map("conversation_id") @db.Uuid
  day                 DateTime  @db.Date
  model               String
  inputTokens         Int       @map("input_tokens")
  outputTokens        Int       @map("output_tokens")
  latencyMs           Int       @map("latency_ms")
  outcome             AiOutcome
  /// AgentProfile.version the reply was generated with (null before profiles).
  agentProfileVersion Int?      @map("agent_profile_version")
  createdAt           DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, day])
  /// The business's monthly count (joined through conversation and line).
  @@index([day])
  @@map("ai_usage")
}

/// Raw webhook delivery, stored (after the signature check) before it is
/// processed, so a processing failure can be retried by the reprocessor. A
/// partial index on received_at WHERE processed_at IS NULL (added by hand in
/// the migration) keeps the pending scan cheap.
model WebhookEvent {
  id          BigInt    @id @default(autoincrement())
  /// Line whose route received and verified the delivery; null for the
  /// keyless default route (resolved to the default line when processed).
  lineId      String?   @map("line_id") @db.Uuid
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  /// Content-free error label of the last failed attempt.
  error       String?

  line Line? @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@map("webhook_event")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED

  @@map("conversation_status")
}

enum MembershipRole {
  OWNER
  AGENT

  @@map("membership_role")
}

/// A person who works a business's inbox. No public sign-up: created by
/// POST /admin/businesses/:id/users. "user" is reserved in Postgres.
model User {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Stored trimmed and in lowercase (normalizeEmail).
  email              String   @unique
  /// argon2id; never returned by the API.
  passwordHash       String   @map("password_hash")
  name               String
  active             Boolean  @default(true)
  /// Set for a temporary password: the web asks for a new one first.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// BotSuite46 team: onboards businesses and lines from the inbox and sees
  /// every line's status (never other businesses' conversations or leads).
  /// Granted only through the admin API.
  staff              Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  memberships           Membership[]
  refreshTokens         RefreshToken[]
  assignedConversations Conversation[]        @relation("ConversationAssignee")
  agentProfileUpdates   AgentProfile[]        @relation("AgentProfileUpdatedBy")
  agentProfileVersions  AgentProfileVersion[] @relation("AgentProfileVersionAuthor")
  catalogImports        CatalogImport[]
  pushSubscriptions     PushSubscription[]

  @@map("app_user")
}

/// A user's access to one business, with their role there.
model Membership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole
  /// false: deactivated in this business (403 there); other businesses unaffected.
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("membership")
}

/// A login's refresh token (14 days). Only its SHA-256 is stored; refresh
/// rotates it (the old row is revoked) and logout revokes it.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

/// A browser (phone or computer) where an inbox person gets Web Push
/// notifications. Notifications go out by the user's memberships.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// The push service URL; it identifies the browser. Never logged.
  endpoint      String    @unique
  /// Encryption keys from the browser (base64url). Never logged.
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Last push the service accepted for it.
  lastSuccessAt DateTime? @map("last_success_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

enum CatalogImportSource {
  CSV      @map("csv")
  API      @map("api")
  SHEET    @map("sheet")
  /// A PDF or a photo read by the model (always a preview).
  DOCUMENT @map("document")

  @@map("catalog_import_source")
}

enum CatalogImportStatus {
  PREVIEW
  APPLIED
  DISCARDED

  @@map("catalog_import_status")
}

/// A product, service or property of a business, with its price. Business
/// information for the bot's search_catalog tool, never instructions. The
/// migration adds by hand the generated `search` column (spanish_unaccent),
/// its GIN index and a pg_trgm index on `name`.
model CatalogItem {
  id          String                   @id @default(uuid()) @db.Uuid
  businessId  String                   @map("business_id") @db.Uuid
  /// The business's own code (SKU), or the normalized name without one.
  externalId  String                   @map("external_id")
  name        String
  description String                   @default("")
  category    String?
  /// Null: the bot says the team confirms the price.
  price       Decimal?                 @db.Decimal(12, 2)
  currency    String                   @default("ARS")
  available   Boolean                  @default(true)
  /// Industry-specific values (text, number or boolean), up to 20 keys.
  attributes  Json                     @default("{}")
  /// Hash of the fields above, to tell which rows changed on import.
  rowHash     String                   @map("row_hash")
  /// Generated by Postgres (see the migration); never written by Prisma.
  search      Unsupported("tsvector")? @default(dbgenerated())
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, externalId])
  @@index([businessId, available])
  @@index([search], type: Gin, map: "catalog_item_search_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "catalog_item_name_trgm_idx")
  @@map("catalog_item")
}

/// One import of a business's catalog: a preview until it is applied or
/// discarded. Its normalized rows live in `rows` until then (purged after 24
/// hours).
model CatalogImport {
  id               String              @id @default(uuid()) @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  source           CatalogImportSource
  status           CatalogImportStatus @default(PREVIEW)
  /// { created, updated, unchanged, unavailable, errors }.
  summary          Json
  /// [{ row, message }], at most 200.
  rowErrors        Json                @default("[]") @map("row_errors")
  /// The valid normalized rows, until applied, discarded or purged.
  rows             Json?
  /// The source records and headers, kept with `rows` so a person can
  /// correct the mapping without uploading again.
  sourceRecords    Json?               @map("source_records")
  headers          Json?
  /// The column mapping used; null for a document (the model gives fields).
  mapping          Json?
  /// False while an AI-proposed mapping waits for a person (no apply).
  mappingConfirmed Boolean             @default(true) @map("mapping_confirmed")
  /// Null when it came from the admin API.
  createdById      String?             @map("created_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  appliedAt        DateTime?           @map("applied_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("catalog_import")
}

/// Model calls of the catalog (column mapping, PDF or photo extraction).
/// They have no conversation; the business's monthly AI cap counts them
/// together with ai_usage. Never stores content.
model CatalogAiUsage {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  /// Calendar day in America/Argentina/Buenos_Aires (usageDay).
  day          DateTime  @db.Date
  /// "mapping" or "extraction".
  purpose      String
  model        String
  inputTokens  Int       @map("input_tokens")
  outputTokens Int       @map("output_tokens")
  latencyMs    Int       @map("latency_ms")
  outcome      AiOutcome
  createdAt    DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, day])
  @@map("catalog_ai_usage")
}
