// Prisma 7 schema for bottega-api.
// The datasource URL lives in prisma.config.ts (not here) as required by Prisma 7.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ConversationMode {
  COMMERCIAL
  DEMO

  @@map("conversation_mode")
}

enum ContextEndReason {
  RESET
  MODE_SWITCH

  @@map("context_end_reason")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageType {
  TEXT
  UNSUPPORTED
  SYSTEM

  @@map("message_type")
}

/// Inbound statuses: RECEIVED, PROCESSED, IGNORED.
/// Outbound statuses: QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, UNCERTAIN.
enum MessageStatus {
  RECEIVED
  PROCESSED
  IGNORED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNCERTAIN

  @@map("message_status")
}

enum MessageAuthor {
  BOT
  HUMAN
  USER

  @@map("message_author")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCARDED

  @@map("lead_status")
}

enum HandoffStatus {
  OPEN
  RESOLVED

  @@map("handoff_status")
}

enum JobType {
  INBOUND_MESSAGE

  @@map("job_type")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("job_status")
}

enum AiOutcome {
  OK
  ERROR
  LIMITED

  @@map("ai_outcome")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A business served by Bottega (one Meta app and portfolio per business).
model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  /// How the bot introduces itself, e.g. "BotSuite, IA de BotSuite46".
  botName   String   @map("bot_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines    Line[]
  contacts Contact[]

  @@map("business")
}

/// A WhatsApp phone number of a business, with its own Meta credentials.
/// Secrets are stored encrypted (LineCredentialsService) and never returned.
model Line {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  /// Meta phone number id (not the phone number). Routes inbound events.
  phoneNumberId        String   @unique @map("phone_number_id")
  /// Messaging account id. Null for the default line seeded from the env.
  wabaId               String?  @map("waba_id")
  displayPhone         String?  @map("display_phone")
  appId                String?  @map("app_id")
  appSecretEncrypted   String?  @map("app_secret_encrypted")
  /// System User token of the business, encrypted.
  accessTokenEncrypted String?  @map("access_token_encrypted")
  /// Generated by Bottega; pasted in the Meta app's webhook configuration.
  verifyToken          String   @map("verify_token")
  /// Random URL-safe key in /webhooks/whatsapp/:webhookKey.
  webhookKey           String   @unique @map("webhook_key")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@index([businessId])
  @@map("line")
}

/// A WhatsApp user as seen by one business (the same person is a different
/// contact for each business).
model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  waId        String   @map("wa_id")
  /// Name sent by Meta in the webhook profile.
  profileName String?  @map("profile_name")
  /// Name set by an operator.
  name        String?
  optOut      Boolean  @default(false) @map("opt_out")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@unique([businessId, waId])
  @@map("contact")
}

/// One thread per (line, contact): it is reopened, never split.
model Conversation {
  id              String           @id @default(uuid()) @db.Uuid
  /// Nullable until every row is backfilled by `npm run seed:default-line`;
  /// a later migration makes it required.
  lineId          String?          @map("line_id") @db.Uuid
  contactId       String?          @map("contact_id") @db.Uuid
  /// User's WhatsApp id. Still unique (one line per wa_id) so the previous
  /// app version keeps working during the deploy; the next migration drops
  /// the constraint. Use contact.waId in new code.
  waId            String           @unique @map("wa_id")
  mode            ConversationMode @default(COMMERCIAL)
  paused          Boolean          @default(false)
  pausedAt        DateTime?        @map("paused_at")
  activeContextId String?          @unique @map("active_context_id") @db.Uuid
  /// Last inbound message time, used to enforce the 24h customer service window.
  lastInboundAt   DateTime?        @map("last_inbound_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  line            Line?                 @relation(fields: [lineId], references: [id], onDelete: Restrict)
  contact         Contact?              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  activeContext   ConversationContext?  @relation("ActiveContext", fields: [activeContextId], references: [id], onDelete: SetNull)
  contexts        ConversationContext[] @relation("ConversationContexts")
  messages        Message[]
  lead            Lead?
  demoRequests    DemoRequest[]
  handoffRequests HandoffRequest[]
  processingJobs  ProcessingJob[]
  aiUsages        AiUsage[]

  @@unique([lineId, contactId])
  @@index([contactId])
  @@map("conversation")
}

model ConversationContext {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  mode           ConversationMode
  startedAt      DateTime          @default(now()) @map("started_at")
  endedAt        DateTime?         @map("ended_at")
  endReason      ContextEndReason? @map("end_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  conversation Conversation  @relation("ConversationContexts", fields: [conversationId], references: [id], onDelete: Cascade)
  activeFor    Conversation? @relation("ActiveContext")
  messages     Message[]
  demoRequests DemoRequest[]

  @@index([conversationId, startedAt])
  @@map("conversation_context")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  contextId      String?          @map("context_id") @db.Uuid
  /// WhatsApp message id (wamid). Unique to deduplicate webhook retries.
  waMessageId    String?          @unique @map("wa_message_id")
  direction      MessageDirection
  type           MessageType
  content        String
  status         MessageStatus
  /// Idempotency key for outbound messages generated by a job.
  idempotencyKey String?          @unique @map("idempotency_key")
  author         MessageAuthor
  errorCode      String?          @map("error_code")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  conversation  Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  context       ConversationContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  processingJob ProcessingJob?

  @@index([contextId, createdAt])
  @@index([conversationId, createdAt])
  @@map("message")
}

/// Real prospect data captured in commercial mode.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @unique @map("conversation_id") @db.Uuid
  name           String?
  businessName   String?    @map("business_name")
  industry       String?
  need           String?
  contactNotes   String?    @map("contact_notes")
  status         LeadStatus @default(NEW)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("lead")
}

/// Fictitious booking captured while running a demo scenario.
model DemoRequest {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  contextId      String   @map("context_id") @db.Uuid
  /// Demo scenario identifier, e.g. "barbershop".
  scenario       String
  customerName   String?  @map("customer_name")
  service        String?
  preferredDate  String?  @map("preferred_date")
  preferredTime  String?  @map("preferred_time")
  notes          String?
  isFictitious   Boolean  @default(true) @map("is_fictitious")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  context      ConversationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("demo_request")
}

model HandoffRequest {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  reason         String?
  status         HandoffStatus @default(OPEN)
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("handoff_request")
}

/// PostgreSQL-backed job queue. A partial unique index (added by hand in the
/// initial migration) guarantees at most one PROCESSING job per conversation.
model ProcessingJob {
  id             String    @id @default(uuid()) @db.Uuid
  /// Monotonic enqueue order. Used by the queue to process the jobs of one
  /// conversation strictly in arrival order (created_at has ms resolution).
  seq            BigInt    @unique @default(autoincrement())
  type           JobType
  conversationId String    @map("conversation_id") @db.Uuid
  messageId      String    @unique @map("message_id") @db.Uuid
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([conversationId, createdAt])
  @@map("processing_job")
}

/// AI call accounting for the daily per-user cap. Never stores message content.
model AiUsage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  day            DateTime  @db.Date
  model          String
  inputTokens    Int       @map("input_tokens")
  outputTokens   Int       @map("output_tokens")
  latencyMs      Int       @map("latency_ms")
  outcome        AiOutcome
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, day])
  @@map("ai_usage")
}
